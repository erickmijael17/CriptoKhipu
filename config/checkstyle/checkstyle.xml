<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Regla R2 / R5 del plan: toda variable termina en "Mija" (constantes en "_MIJA").
  Se aplica a main y test. La variable sin nombre "_" (Java 22+) está permitida.
  No aplica a clases, métodos, paquetes ni constantes de enum.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <!-- Variables y campos de instancia -->
        <module name="LocalVariableName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*Mija|_)$"/>
            <property name="allowOneCharVarInForLoop" value="false"/>
        </module>
        <module name="LocalFinalVariableName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*Mija|_)$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*Mija$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*Mija|_)$"/>
        </module>
        <module name="LambdaParameterName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*Mija|_)$"/>
        </module>
        <module name="CatchParameterName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*Mija|_)$"/>
        </module>
        <module name="PatternVariableName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*Mija|_)$"/>
        </module>
        <module name="RecordComponentName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*Mija$"/>
        </module>

        <!-- Constantes (static final): MAYUSCULAS_MIJA -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9_]*_MIJA$"/>
        </module>
        <!-- Campos estáticos no finales: son variables, van en camelCase + Mija -->
        <module name="StaticVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*Mija$"/>
        </module>
    </module>
</module>
