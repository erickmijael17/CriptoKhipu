<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="12" maxWidth="560"
      fx:controller="dev.erick.cryptokipu.ui.vista.AjustesController">
    <Label text="%ajustes.titulo" styleClass="title-2"/>
    <Label text="%ajustes.tema" styleClass="title-4"/>
    <ComboBox fx:id="temaMija" accessibleText="%ajustes.tema"/>
    <Label text="%ajustes.idioma" styleClass="title-4"/>
    <ComboBox fx:id="idiomaMija" accessibleText="%ajustes.idioma"/>
    <CheckBox fx:id="recientesMija" text="%ajustes.recientes"/>
    <Label text="%ajustes.autobloqueo" styleClass="title-4"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Spinner fx:id="autobloqueoMinutosMija" editable="true" prefWidth="100"/>
        <Label text="%ajustes.autobloqueo.minutos"/>
    </HBox>
    <Label text="%ajustes.autobloqueo.ayuda" styleClass="text-muted" wrapText="true"/>
    <CheckBox fx:id="bloquearMinimizarMija" text="%ajustes.bloquearMinimizar"/>
    <Label fx:id="mensajeMija" styleClass="text-muted" wrapText="true"/>
    <Button fx:id="acercaDeMija" text="%ajustes.acercaDe" onAction="#acercaDe"/>
</VBox>
