<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="10"
      fx:controller="dev.erick.cryptokipu.ui.vista.ExploradorController">
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="agregarMija" text="%explorador.agregar" onAction="#agregar" mnemonicParsing="true"
                styleClass="accent"/>
        <Button fx:id="extraerMija" text="%explorador.extraer" onAction="#extraer" mnemonicParsing="true"/>
        <Button fx:id="extraerTodoMija" text="%explorador.extraerTodo" onAction="#extraerTodo"/>
        <Button fx:id="abrirExternoMija" text="%explorador.abrirExterno" onAction="#abrirExterno"/>
        <Button fx:id="eliminarMija" text="%explorador.eliminar" onAction="#eliminar" styleClass="danger"/>
        <Button fx:id="eliminarCompactarMija" text="%explorador.eliminarCompactar" onAction="#eliminarCompactar"
                styleClass="danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="%explorador.siExiste"/>
        <ComboBox fx:id="politicaMija"/>
    </HBox>
    <TextField fx:id="filtroMija" promptText="%explorador.filtro" accessibleText="%explorador.filtro"/>
    <SplitPane fx:id="divisionMija" dividerPositions="0.62" VBox.vgrow="ALWAYS">
        <TreeTableView fx:id="tablaMija" showRoot="false">
            <columns>
                <TreeTableColumn fx:id="columnaNombreMija" text="%explorador.nombre" prefWidth="280"/>
                <TreeTableColumn fx:id="columnaTamanoMija" text="%explorador.tamano" prefWidth="90"/>
                <TreeTableColumn fx:id="columnaFechaMija" text="%explorador.fecha" prefWidth="140"/>
                <TreeTableColumn fx:id="columnaTipoMija" text="%explorador.tipo" prefWidth="140"/>
            </columns>
        </TreeTableView>
        <VBox spacing="8">
            <Label text="%explorador.previa" styleClass="title-4"/>
            <StackPane VBox.vgrow="ALWAYS">
                <Label fx:id="sinPreviaMija" text="%explorador.sinSeleccion" wrapText="true"
                       styleClass="text-muted"/>
                <ScrollPane fx:id="marcoImagenMija" fitToWidth="true" fitToHeight="true" visible="false">
                    <ImageView fx:id="imagenMija" preserveRatio="true"/>
                </ScrollPane>
                <TextArea fx:id="textoMija" editable="false" wrapText="true" visible="false"/>
                <VBox fx:id="panelMedioMija" spacing="8" visible="false">
                    <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: black;">
                        <MediaView fx:id="vistaMedioMija" preserveRatio="true"/>
                    </StackPane>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button fx:id="reproducirMija" text="%medio.reproducir" onAction="#alternarReproduccion"/>
                        <Slider fx:id="posicionMija" HBox.hgrow="ALWAYS" accessibleText="%medio.posicion"/>
                        <Label fx:id="tiempoMija" styleClass="text-muted"/>
                    </HBox>
                </VBox>
            </StackPane>
            <HBox fx:id="controlesPaginaMija" spacing="8" alignment="CENTER" visible="false" managed="false">
                <Button fx:id="paginaAnteriorMija" text="%pagina.anterior" onAction="#paginaAnterior"/>
                <Label fx:id="paginaMija"/>
                <Button fx:id="paginaSiguienteMija" text="%pagina.siguiente" onAction="#paginaSiguiente"/>
            </HBox>
        </VBox>
    </SplitPane>
    <Label fx:id="resumenMija" styleClass="text-muted"/>
</VBox>
