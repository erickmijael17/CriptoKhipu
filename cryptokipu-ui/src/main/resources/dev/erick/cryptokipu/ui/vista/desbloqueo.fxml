<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="10" maxWidth="460"
      fx:controller="dev.erick.cryptokipu.ui.vista.DesbloqueoController">
    <Label text="%desbloqueo.titulo" styleClass="title-2"/>
    <Label fx:id="nombreMija" styleClass="text-muted" wrapText="true"/>
    <Label fx:id="avisoIntentosMija" styleClass="aviso" wrapText="true"/>

    <VBox fx:id="credencialesMija" spacing="10">
        <Label text="%desbloqueo.f1"/>
        <PasswordField fx:id="f1Mija"/>
        <Label text="%desbloqueo.f2"/>
        <PasswordField fx:id="f2Mija"/>
        <Label text="%desbloqueo.f3"/>
        <PasswordField fx:id="f3Mija"/>
        <HBox fx:id="filaLlaveMija" spacing="8" alignment="CENTER_LEFT">
            <Label text="%desbloqueo.llave"/>
            <Label fx:id="llaveElegidaMija" styleClass="text-muted"/>
            <Button fx:id="elegirLlaveMija" text="%asistente.llave.elegir" onAction="#elegirLlave"/>
        </HBox>
    </VBox>

    <VBox fx:id="recuperacionMija" spacing="10">
        <Label text="%desbloqueo.token"/>
        <PasswordField fx:id="tokenMija" styleClass="token"/>
        <Label text="%desbloqueo.f1"/>
        <PasswordField fx:id="f1TokenMija"/>
    </VBox>

    <Label fx:id="errorMija" styleClass="error-credenciales" wrapText="true"/>
    <Label fx:id="esperaMija" styleClass="aviso" wrapText="true"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="abrirMija" text="%desbloqueo.abrir" onAction="#abrir" mnemonicParsing="true"
                styleClass="accent" defaultButton="true"/>
        <Hyperlink fx:id="cambiarModoMija" onAction="#cambiarModo"/>
    </HBox>
</VBox>
