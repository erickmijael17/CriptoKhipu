<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="raizMija" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="dev.erick.cryptokipu.ui.vista.ShellController">
    <BorderPane>
        <left>
            <VBox styleClass="menu-lateral" spacing="4">
                <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
                <Label text="%app.titulo" styleClass="title-3, marca"/>
                <Region minHeight="12"/>
                <Button fx:id="botonInicioMija" text="%nav.inicio" onAction="#irInicio" maxWidth="Infinity"
                        styleClass="flat, boton-menu" accessibleText="%nav.inicio"/>
                <Button fx:id="botonExploradorMija" text="%nav.explorador" onAction="#irExplorador" maxWidth="Infinity"
                        styleClass="flat, boton-menu"/>
                <Button fx:id="botonSeguridadMija" text="%nav.seguridad" onAction="#irSeguridad" maxWidth="Infinity"
                        styleClass="flat, boton-menu"/>
                <Button fx:id="botonAjustesMija" text="%nav.ajustes" onAction="#irAjustes" maxWidth="Infinity"
                        styleClass="flat, boton-menu"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Label fx:id="rutaBovedaMija" styleClass="text-small, text-muted" wrapText="true"/>
                <Button fx:id="botonCerrarBovedaMija" text="%nav.cerrarBoveda" onAction="#cerrarBoveda"
                        maxWidth="Infinity" styleClass="button-outlined"/>
            </VBox>
        </left>
        <center>
            <StackPane fx:id="contenidoMija" styleClass="contenido"/>
        </center>
        <bottom>
            <Label fx:id="notificacionMija" styleClass="notificacion" maxWidth="Infinity" visible="false"
                   managed="false"/>
        </bottom>
    </BorderPane>
    <StackPane fx:id="capaProgresoMija" styleClass="capa-progreso" visible="false">
        <VBox styleClass="tarjeta" spacing="12" maxWidth="420" maxHeight="160">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label fx:id="etapaMija" styleClass="title-4" wrapText="true"/>
            <ProgressBar fx:id="barraProgresoMija" maxWidth="Infinity" progress="-1"/>
            <Button fx:id="cancelarProgresoMija" text="%progreso.cancelar" onAction="#cancelarTarea"
                    cancelButton="true"/>
        </VBox>
    </StackPane>
</StackPane>
